+add_library(cryptopp::cryptopp ALIAS cryptopp)
+target_compile_features(cryptopp PUBLIC cxx_std_11)
+# Headers include template implementations such as algebra.cpp and eprecomp.cpp.
+target_include_directories(cryptopp PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
+set_target_properties(cryptopp PROPERTIES
+	MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+
+if(WIN32)
+	# osrng.cpp selects CryptoAPI or CNG from the consumer's Windows SDK level.
+	target_link_libraries(cryptopp PUBLIC advapi32 bcrypt)
+endif()
+if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+	# Upstream GH #1134/#1141: GCC can remove required virtual calls.
+	target_compile_options(cryptopp PRIVATE -fno-devirtualize)
+endif()
+
+string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _cryptopp_processor)
+if(_cryptopp_processor MATCHES "^(x86_64|amd64|x64|i[3-6]86|x86)$"
+	OR MSVC AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "ARM")
+	if(MSVC)
+		target_compile_options(cryptopp PRIVATE
+			$<$<COMPILE_LANGUAGE:CXX>:/EHsc;/GR>)
+		if(CMAKE_SIZEOF_VOID_P EQUAL 4)
+			target_compile_options(cryptopp PRIVATE
+				$<$<COMPILE_LANGUAGE:CXX>:/arch:SSE2>)
+		endif()
+		set_source_files_properties(chacha_avx.cpp lsh256_avx.cpp
+			lsh512_avx.cpp PROPERTIES COMPILE_OPTIONS /arch:AVX2)
+
+		enable_language(ASM_MASM)
+		set(_cryptopp_asm rdrand rdseed)
+		if(CMAKE_SIZEOF_VOID_P EQUAL 8)
+			list(APPEND _cryptopp_asm cpuid64 x64dll x64masm)
+			set(_cryptopp_asm_options /D_M_X64)
+		else()
+			set(_cryptopp_asm_options /D_M_X86 /safeseh)
+		endif()
+		# Unique object names avoid rdrand.cpp/rdrand.asm collisions in VS.
+		foreach(_asm IN LISTS _cryptopp_asm)
+			set(_object
+				"${CMAKE_CURRENT_BINARY_DIR}/$<CONFIG>/${_asm}.asm.obj")
+			add_custom_command(OUTPUT "${_object}"
+				COMMAND "${CMAKE_COMMAND}" -E make_directory
+					"${CMAKE_CURRENT_BINARY_DIR}/$<CONFIG>"
+				COMMAND "${CMAKE_ASM_MASM_COMPILER}" /c /nologo /W3 /Cx
+					${_cryptopp_asm_options} "$<$<CONFIG:Debug>:/Zi>"
+					"/Fo${_object}"
+					"${CMAKE_CURRENT_SOURCE_DIR}/${_asm}.asm"
+				DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_asm}.asm"
+				COMMAND_EXPAND_LISTS VERBATIM)
+			target_sources(cryptopp PRIVATE "${_object}")
+		endforeach()
+	elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+		# Match GNUmakefile's per-translation-unit ISA options. CPU dispatch
+		# remains baseline so the resulting library runs on older CPUs.
+		set_source_files_properties(chacha_simd.cpp donna_sse.cpp
+			sse_simd.cpp PROPERTIES COMPILE_OPTIONS -msse2)
+		set_source_files_properties(cham_simd.cpp keccak_simd.cpp
+			lea_simd.cpp lsh256_sse.cpp lsh512_sse.cpp
+			simon128_simd.cpp speck128_simd.cpp
+			PROPERTIES COMPILE_OPTIONS -mssse3)
+		set_source_files_properties(blake2b_simd.cpp blake2s_simd.cpp
+			PROPERTIES COMPILE_OPTIONS -msse4.1)
+		set_source_files_properties(crc_simd.cpp
+			PROPERTIES COMPILE_OPTIONS -msse4.2)
+		set_source_files_properties(gcm_simd.cpp
+			PROPERTIES COMPILE_OPTIONS "-mssse3;-mpclmul")
+		set_source_files_properties(gf2n_simd.cpp
+			PROPERTIES COMPILE_OPTIONS -mpclmul)
+		set_source_files_properties(rijndael_simd.cpp
+			PROPERTIES COMPILE_OPTIONS "-msse4.1;-maes")
+		set_source_files_properties(sm4_simd.cpp
+			PROPERTIES COMPILE_OPTIONS "-mssse3;-maes")
+		set_source_files_properties(chacha_avx.cpp lsh256_avx.cpp
+			lsh512_avx.cpp PROPERTIES COMPILE_OPTIONS -mavx2)
+		set_source_files_properties(sha_simd.cpp shacal2_simd.cpp
+			PROPERTIES COMPILE_OPTIONS "-msse4.2;-msha")
+	endif()
+endif()
